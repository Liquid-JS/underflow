{
    "name": "@liquid-js/underflow",
    "version": "4.0.0-1",
    "description": "Markdown editor with live preview and WYSIWYG modes, CommonMark + GFM",
    "type": "module",
    "types": "./lib/index.d.ts",
    "exports": {
        "./package.json": {
            "default": "./package.json"
        },
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        },
        "./viewer": {
            "types": "./lib/viewer.d.ts",
            "default": "./lib/viewer.js"
        },
        "./parser": {
            "types": "./lib/parser.d.ts",
            "default": "./lib/parser.js"
        },
        "./i18n/*": {
            "types": "./lib/editor/i18n/*.d.ts",
            "default": "./lib/i18n/*.js"
        },
        "./i18n/i18n": null,
        "./i18n/texts/*": null,
        "./plugins/code-syntax-highlight": {
            "types": "./lib/plugins/code-syntax-highlight.d.ts",
            "default": "./lib/plugins/code-syntax-highlight.js"
        },
        "./styles/*": "./lib/styles/*",
        "./scss/*": "./lib/scss/*"
    },
    "sideEffects": [
        "*.css"
    ],
    "files": [
        "lib"
    ],
    "dependencies": {
        "entities": "^9.0.0",
        "mdurl": "^2.1.0"
    },
    "peerDependencies": {
        "dompurify": "^3.4.17",
        "highlight.js": "^11.12.0",
        "prosemirror-commands": "^1.7.2",
        "prosemirror-history": "^1.5.1",
        "prosemirror-inputrules": "^1.5.1",
        "prosemirror-keymap": "^1.2.3",
        "prosemirror-model": "^1.25.12",
        "prosemirror-state": "^1.4.4",
        "prosemirror-transform": "^1.12.5",
        "prosemirror-view": "^1.42.9"
    },
    "peerDependenciesMeta": {
        "highlight.js": {
            "optional": true
        }
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@liquid-js/rollup-plugin-closure-compiler": "^0.28.3",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.2",
        "@rollup/plugin-typescript": "^12.3.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/stylelint-config": "^5.0.0",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@types/common-tags": "^1.8.4",
        "@types/node": "<27.0.0",
        "clean-package": "^2.2.0",
        "commit-and-tag-version": "<13.1.0",
        "common-tags": "^1.8.2",
        "dompurify": "^3.4.17",
        "eslint": "^10.14.0",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-jsdoc": "^65.4.5",
        "eslint-plugin-prefer-arrow-functions": "^3.10.2",
        "eslint-plugin-unused-imports": "^4.4.1",
        "google-closure-compiler": "^20261104.0.0",
        "highlight.js": "^11.12.0",
        "husky": "^9.1.7",
        "js-beautify": "^2.0.3",
        "jsdom": "^31.0.0",
        "npm-check-updates": "^23.1.1",
        "postcss": "^8.5.32",
        "prosemirror-commands": "^1.7.2",
        "prosemirror-history": "^1.5.1",
        "prosemirror-inputrules": "^1.5.1",
        "prosemirror-keymap": "^1.2.3",
        "prosemirror-model": "^1.25.12",
        "prosemirror-state": "^1.4.4",
        "prosemirror-transform": "^1.12.5",
        "prosemirror-view": "^1.42.9",
        "rimraf": "^6.1.4",
        "rollup": "^4.68.0",
        "rollup-plugin-minify-template-literals": "^2.2.0",
        "sass": "^1.108.0",
        "stylelint": "^17.16.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "svgo": "^4.1.0",
        "tslib": "^2.9.1",
        "typedoc": "^0.28.20",
        "typescript": "<7.0.0",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    },
    "scripts": {
        "build": "rimraf lib && rollup -c rollup.config.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:types": "tsc --noEmit",
        "docs": "typedoc --tsconfig ./tsconfig.lib.json",
        "start": "vite demo",
        "smoke": "yarn build && yarn pack -o underflow.tgz && clean-package restore && cd smoke && rimraf node_modules/@liquid-js/underflow package-lock.json && npm install --no-audit --no-fund --ignore-scripts && npm run build && npm run e2e",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:sass": "stylelint \"{src,demo,smoke/src}/**/*.scss\"",
        "lint:sass:fix": "stylelint \"{src,demo,smoke/src}/**/*.scss\" --fix",
        "lint:html": "js-beautify --type html -r -f demo/index.html smoke/index.html --config ./js-beautify.json",
        "prepublishOnly": "yarn build",
        "prepare": "husky",
        "release": "git diff --exit-code && commit-and-tag-version && git push --follow-tags origin",
        "prelease": "git diff --exit-code && commit-and-tag-version -p && git push --follow-tags origin",
        "prepack": "clean-package",
        "postpack": "clean-package restore"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Liquid-JS/underflow.git"
    },
    "keywords": [
        "markdown",
        "editor",
        "wysiwyg",
        "preview",
        "commonmark",
        "gfm",
        "prosemirror"
    ],
    "author": "HitkoDev <development@hitko.si>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/Liquid-JS/underflow/issues"
    },
    "homepage": "https://github.com/Liquid-JS/underflow#readme",
    "packageManager": "yarn@4.18.1",
    "clean-package": {
        "remove": [
            "packageManager",
            "scripts",
            "devDependencies",
            "clean-package",
            "resolutions",
            "engines"
        ]
    }
}
