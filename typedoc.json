{
    "$schema": "https://typedoc.org/schema.json",
    "entryPoints": [
        "./src/index.ts",
        "./src/viewer.ts",
        "./src/parser.ts",
        "./src/plugins/code-syntax-highlight.ts"
    ],
    "readme": "./README.md",
    "favicon": "./docs/images/icon.svg",
    "customCss": "./docs/typedoc.css",
    "projectDocuments": [
        "./docs/getting-started.md",
        "./docs/editing.md",
        "./docs/toolbar.md",
        "./docs/viewer.md",
        "./docs/theming.md",
        "./docs/i18n.md",
        "./docs/extended-autolinks.md",
        "./docs/widget.md",
        "./docs/custom-html-renderer.md",
        "./docs/custom-block.md",
        "./docs/plugin.md",
        "./docs/code-syntax-highlight-plugin.md"
    ],
    "out": "pages/docs",
    "sort": [
        "kind",
        "instance-first",
        "source-order"
    ],
    "highlightLanguages": [
        "bash",
        "css",
        "html",
        "javascript",
        "json",
        "markdown",
        "md",
        "scss",
        "shellscript",
        "typescript",
        "ts",
        "js",
        "yaml"
    ],
    "treatWarningsAsErrors": true
}
